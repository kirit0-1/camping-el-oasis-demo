{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/reservar", "destination": "/reservar.html" },
    { "source": "/presupuesto", "destination": "/presupuesto.html" },
    { "source": "/mantencion", "destination": "/mantencion.html" }
  ]
}
